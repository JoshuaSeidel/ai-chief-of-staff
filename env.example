# AI Chief of Staff environment template
#
# Copy to `.env`, replace every generated/placeholder secret, then run:
#   docker compose up --build -d
#
# Most product configuration belongs in the app UI under Settings. Keep this
# file focused on deployment, security, service discovery, and OAuth callback
# fallbacks.

# =============================================================================
# Required Security
# =============================================================================

# Required for API authentication and destructive admin tools.
# Settings > System > Danger Zone > Wipe History will not run unless
# AICOS_AUTH_TOKEN or API_TOKEN is configured.
#
# Generate with:
#   openssl rand -base64 48
AICOS_AUTH_TOKEN=replace-with-a-long-random-token

# Backward-compatible alias. Prefer AICOS_AUTH_TOKEN unless an older deployment
# already uses API_TOKEN.
API_TOKEN=

# Do not set VITE_API_TOKEN for public deployments. Leaving it blank makes the
# browser prompt authorized users for the token instead of baking a shared token
# into frontend assets.
VITE_API_TOKEN=

# Used to sign OAuth state. If omitted, the app can generate and store one, but
# production deployments should set a stable secret.
OAUTH_STATE_SECRET=replace-with-a-long-random-oauth-state-secret

# Browser origins allowed to call the API. For local Docker Compose, the defaults
# below work. In production, replace both with your public HTTPS origin.
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
ALLOW_LOCALHOST_CORS=false

# =============================================================================
# Database And Ports
# =============================================================================

DB_TYPE=postgres
POSTGRES_DB=aicos
POSTGRES_USER=aicos

# Required. Do not use the sample value in production.
# Generate a URL-safe value because Compose also places it inside DATABASE_URL:
#   openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-secure-postgres-password

FRONTEND_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optional microservice host ports.
AI_INTELLIGENCE_PORT=8001
PATTERN_RECOGNITION_PORT=8002
NL_PARSER_PORT=8003
VOICE_PROCESSOR_PORT=8004
CONTEXT_SERVICE_PORT=8005
INTEGRATIONS_PORT=8006

# =============================================================================
# Runtime
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info
TZ=America/New_York
PUID=1000
PGID=1000

# Frontend API URL is a Vite build-time variable in the frontend image.
# `/api` is correct when using the included frontend nginx proxy.
VITE_API_URL=/api

# Internal service TLS. The bundled Docker Compose stack generates a shared
# self-signed CA on first start (via the tls-certs volume) and pins it on the
# backend, so certificate verification works out-of-the-box. Leave this unset
# (false) for both local and production. Set to true ONLY if you cannot mount
# the shared CA — this disables certificate verification on backend->service
# calls and exposes the internal network to MITM.
ALLOW_INSECURE_TLS=false

JSON_BODY_LIMIT=10mb
FORM_BODY_LIMIT=1mb
API_RATE_LIMIT_MAX=600
OAUTH_RATE_LIMIT_MAX=40

# Optional build metadata.
VERSION=2.3.2
COMMIT_HASH=unknown
BUILD_DATE=

# =============================================================================
# Production Domain And Reverse Proxy
# =============================================================================

# Set these for HTTPS deployments.
DOMAIN=aicos.yourdomain.com
EMAIL=admin@yourdomain.com

# SWAG DNS plugin, if using the SWAG guide.
# Examples: cloudflare, duckdns, route53
DNS_PLUGIN=cloudflare

# Production origin example:
# FRONTEND_URL=https://aicos.yourdomain.com
# ALLOWED_ORIGINS=https://aicos.yourdomain.com
# TRUST_PROXY=true

# =============================================================================
# OAuth Redirect Fallbacks
# =============================================================================

# These can also be saved in Settings. Environment values are useful for
# repeatable deployments and reverse-proxy setups.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/google/callback
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/calendar/microsoft/callback

# Production examples:
# GOOGLE_REDIRECT_URI=https://aicos.yourdomain.com/api/calendar/google/callback
# MICROSOFT_REDIRECT_URI=https://aicos.yourdomain.com/api/calendar/microsoft/callback

# =============================================================================
# Microsoft 365 App Registration
# =============================================================================

# Optional in env because these can be entered in Settings. Required for
# Microsoft 365 app-only Teams transcript/recording capture fallback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# =============================================================================
# AI Providers And Storage Fallbacks
# =============================================================================

# Prefer entering provider keys in Settings so they can be changed without a
# container rebuild. These environment values remain available as fallback for
# automation or first boot.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://aicos-ollama:11434

# Optional model defaults.
CLAUDE_MODEL=claude-sonnet-4-5-20250929
WHISPER_MODEL=whisper-1

# =============================================================================
# Push Notifications
# =============================================================================

# The backend can generate VAPID keys. Set these only if you manage keys
# externally and want deterministic values across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
