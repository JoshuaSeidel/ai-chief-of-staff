# AI Chief of Staff - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DEPLOYMENT MODE
# ============================================
# standalone = Single container (simpler)
# microservices = Separate services (better performance)
DEPLOYMENT_MODE=standalone

# ============================================
# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# AI Model Configuration (Optional - using optimized defaults)
# Claude Model for task intelligence, pattern recognition, and NLP parsing
# Options: claude-sonnet-4-5-20250929 (recommended - latest), claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Whisper Model for audio transcription
# Options: whisper-1 (recommended - fastest and most accurate)
WHISPER_MODEL=whisper-1

# ============================================
# REQUIRED: Domain Configuration (for production)
# ============================================
DOMAIN=aicos.yourdomain.com
EMAIL=admin@yourdomain.com

# ============================================
# REQUIRED: Database Configuration
# ============================================
POSTGRES_DB=ai_chief_of_staff
POSTGRES_USER=aicos
POSTGRES_PASSWORD=your-secure-password-here-change-this
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# REQUIRED: SWAG/Let's Encrypt DNS Validation
# ============================================
# Choose your DNS provider plugin:
# cloudflare, duckdns, route53, etc.
# See: https://github.com/linuxserver/docker-swag#parameters
DNS_PLUGIN=cloudflare

# For Cloudflare DNS validation, add these to swag-config/dns-conf/cloudflare.ini:
# dns_cloudflare_email = your@email.com
# dns_cloudflare_api_key = your-cloudflare-api-key

# ============================================
# MICROSERVICES: Service URLs (only if DEPLOYMENT_MODE=microservices)
# ============================================
# Redis (required for microservices)
REDIS_URL=redis://redis:6379

# AI Services
AI_INTELLIGENCE_URL=http://ai-intelligence:8001
PATTERN_RECOGNITION_URL=http://pattern-recognition:8002
NL_PARSER_URL=http://nl-parser:8003
VOICE_PROCESSOR_URL=http://voice-processor:8004
CONTEXT_SERVICE_URL=http://context-service:8005

# ============================================
# OPTIONAL: Google Calendar Integration
# ============================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/google/callback

# ============================================
# OPTIONAL: Microsoft 365 Integration
# ============================================
# Delegated OAuth is used for calendar, mailbox, and Planner/To Do access.
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/calendar/microsoft/callback

# Teams transcript/recording capture uses Microsoft Graph application permissions:
# OnlineMeetings.Read.All, OnlineMeetingTranscript.Read.All, OnlineMeetingRecording.Read.All.
# Microsoft also requires a Teams application access policy for these app-only
# online meeting artifact APIs. Create and grant that policy with Teams PowerShell
# for the users or tenant the app may access.

# ============================================
# OPTIONAL: Push Notifications (Web Push)
# ============================================
# Generate VAPID keys with: npx web-push generate-vapid-keys
# Or leave blank and generate in the UI later
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ============================================
# REQUIRED: SWAG/Let's Encrypt DNS Validation (production only)
# ============================================
# Choose your DNS provider plugin:
# cloudflare, duckdns, route53, etc.
# See: https://github.com/linuxserver/docker-swag#parameters
DNS_PLUGIN=cloudflare

# For Cloudflare DNS validation, add these to swag-config/dns-conf/cloudflare.ini:
# dns_cloudflare_email = your@email.com
# dns_cloudflare_api_key = your-cloudflare-api-key

# ============================================
# OPTIONAL: System Configuration
# ============================================
# User/Group IDs for file permissions
PUID=1000
PGID=1000

# Timezone (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/New_York

# Node environment
NODE_ENV=production

# ============================================
# OPTIONAL: Security Controls
# ============================================
# Comma-separated browser origins allowed to call the backend API.
# Set this in production instead of relying on localhost development defaults.
FRONTEND_URL=https://aicos.yourdomain.com
ALLOWED_ORIGINS=https://aicos.yourdomain.com

# Optional API token. If set, API requests must include:
# Authorization: Bearer <token>
AICOS_AUTH_TOKEN=generate-a-long-random-token
# For controlled private builds only. Public deployments should leave this blank
# and let authorized users enter the token in the in-app secure API prompt.
VITE_API_TOKEN=

# Used to sign OAuth state. If omitted, the app generates and stores one.
OAUTH_STATE_SECRET=generate-a-long-random-secret

# Allow localhost CORS while NODE_ENV=production for local review only.
ALLOW_LOCALHOST_CORS=false
TRUST_PROXY=true

# Request limits/rate limits.
JSON_BODY_LIMIT=10mb
FORM_BODY_LIMIT=1mb
API_RATE_LIMIT_MAX=600
OAUTH_RATE_LIMIT_MAX=40

# ============================================
# NOTE: Additional configuration in the UI
# ============================================
# After starting, configure these in the web UI:
# - Claude Model selection
# - Calendar settings
# - Max tokens for AI responses
# - Custom AI prompts
